{
  "name": "beauty-salon-success",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build --mode client && vite build",
    "preview": "pnpm run build && wrangler dev dist/_worker.js --local",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:preview": "pnpm run build && wrangler deploy --env preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "hono": "^4.13.13",
    "honox": "^0.1.62"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@hono/vite-build": "^1.11.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.28.0",
      "sharp@<0.35.5": "^0.35.5"
    }
  }
}
